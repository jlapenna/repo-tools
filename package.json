{
  "name": "@jlapenna/repo-tools",
  "version": "0.0.0",
  "private": false,
  "description": "General repository-management commands for worktree safety and CI monitoring.",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24",
    "pnpm": "11.24.0"
  },
  "bin": {
    "repo-require-worktree": "bin/require-feature-worktree.sh",
    "repo-check-dependencies": "bin/check-dependencies.sh",
    "repo-nx": "bin/nx.sh",
    "repo-safe-remove-worktree": "bin/safe-remove-worktree.sh",
    "repo-watch-run": "bin/watch-run.cjs",
    "repo-watch-prs": "bin/watch-prs.sh",
    "repo-scan-live-processes": "bin/scan-live-processes.sh",
    "repo-sweep-worktrees": "bin/sweep-worktrees.sh"
  },
  "exports": {
    "./eslint": "./eslint/index.mjs"
  },
  "files": [
    "bin",
    "eslint/index.mjs"
  ],
  "scripts": {
    "build": "node scripts/build-eslint.mjs",
    "test": "bash bin/check-dependencies.test.sh && bash bin/safe-remove-worktree.test.sh && bash bin/sweep-worktrees.test.sh && bash bin/watch-prs.test.sh && node --test plugins/manifests.test.mjs && pnpm run build && node --test eslint/test/consumer-contract.test.mjs && vitest run eslint/test/rules"
  },
  "dependencies": {
    "@nx/devkit": "23.1.1",
    "@typescript-eslint/utils": "8.58.0"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "eslint": "10.2.1",
    "typescript-eslint": "8.58.0",
    "vitest": "4.1.4"
  }
}
